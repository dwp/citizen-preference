{% extends "layouts/main.html" %}

{% block beforeContent %}

{{ govukBackLink({
      text: "Back",
      href: "javascript:window.history.back()"
  }) }}
  
  <ul class="dwp-language-toggle__list">
    <li class="dwp-language-toggle__list-item" aria-current="true"> <span class="govuk-body-s"> English  </span></li>
    <li class="dwp-language-toggle__list-item">    
    <a href="#" hreflang="cy" lang="cy" rel="alternate" class="govuk-link--no-visited-state" aria-label="Newid yr iaith ir Gymraeg">Cymraeg</a>
    </li>
  </ul>

{% endblock %}

{% block content %}

{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}

<div class="govuk-error-summary" data-module="govuk-error-summary">
  <div role="alert">
    <h2 class="govuk-error-summary__title">
      There is a problem
    </h2>
    <div class="govuk-error-summary__body">
      <ul class="govuk-list govuk-error-summary__list">
        <li>
          <a href="#select-language">Select which language we should write to you in</a>
        </li>
      </ul>
    </div>
  </div>
</div>


  <form action="/agent/agent-view/language/language-selection" method="post" novalidate>
    {{ govukRadios({
      name: "SelectLanguage",
      fieldset: {
        legend: {
          text: "Which language should we write to you in?",
          isPageHeading: true,
          classes: "govuk-fieldset__legend--l"
        }
    },
    errorMessage: {
      text: "Select which language we should write to you in"
    },
    items: [
      {
        value: "English",
        text: "English"
      },
      {
        value: "Welsh",
        text: "Welsh"
      }
    ]
    })  
  }}

    {{ govukButton({
      text: "Continue"
    }) }}
  </form>

{% endblock %}