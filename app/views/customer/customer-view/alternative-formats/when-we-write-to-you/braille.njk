{% extends "layouts/main.html" %}

{% block beforeContent %}

{{ govukBackLink({
      text: "Back",
      href: "javascript:window.history.back()"
  }) }}
  
  <ul class="dwp-language-toggle__list">
    <li class="dwp-language-toggle__list-item" aria-current="true"> <span class="govuk-body-s"> English  </span></li>
    <li class="dwp-language-toggle__list-item">    
    <a href="#" hreflang="cy" lang="cy" rel="alternate" class="govuk-link--no-visited-state" aria-label="Newid yr iaith ir Gymraeg">Cymraeg</a>
    </li>
  </ul>

{% endblock %}

{% block content %}

<form class="form" id="radioForm" action="/customer/customer-view/alternative-formats/when-we-write-to-you/braille" method="post" novalidate>
  {{ govukRadios({
        name: "Braille",
        fieldset: {
          legend: {
            text: "What type of braille do you need?",
            isPageHeading: true,
            classes: "govuk-fieldset__legend--l"
          }
        },
        items: [
          {
            value: "Uncontracted braille (grade 1)",
            text: "Uncontracted braille (grade 1)"
          },
          {
            value: "Contracted braille (grade 2)",
            text: "Contracted braille (grade 2)"
          }
        ]
        })  
      }}

      {{ govukButton({
      text: "Continue"
    }) }}
</form>

{% endblock %}